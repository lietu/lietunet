    "prettier": "^3.4.2",
    "prettier-plugin-svelte": "^3.3.3",
    "svelte": "^5.0.0",
    "svelte-check": "^4.0.0",
    "typescript": "^5.0.0",
    "vite": "^6.2.5"
  },
  "dependencies": {
    "@fontsource-variable/merriweather-sans": "^5.2.7",
    "@picocss/pico": "^2.1.1",
    "@poppanator/sveltekit-svg": "^6.0.1",
    "sass": "^1.86.3"
  },
  "trustedDependencies": [
    "@parcel/watcher",
    "core-js",
    "esbuild"
  ]
